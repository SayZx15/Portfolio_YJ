# Backend only. Never commit .env or put these values into src/.
# Required for sending mail through the optional API:
RESEND_API_KEY=
CONTACT_FROM=Johan Portfolio <portfolio@your-verified-domain.com>
CONTACT_TO=yangjohan2004@gmail.com
# Origins only, without a trailing slash or repository path:
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PORT=3001
# For container hosting, set HOST=0.0.0.0. Local default stays 127.0.0.1.
HOST=127.0.0.1
